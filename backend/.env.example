# ──────────────────────────────────────────────────────────────
# PORTAL DA COMUNIDADE — Backend do Assistente Educacional
# ──────────────────────────────────────────────────────────────
# 1. Copie este arquivo para .env:   cp .env.example .env
# 2. Preencha GEMINI_API_KEY com sua chave real
# 3. NUNCA suba o arquivo .env para o GitHub (já está no .gitignore)
# ──────────────────────────────────────────────────────────────

# Chave da API Google Gemini
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Porta do servidor (padrão: 3001)
PORT=3001

# Modelo Gemini a usar
# Recomendado: gemini-2.5-flash (mais capaz, gratuito)
# Alternativa: gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Máximo de tokens por resposta
MAX_TOKENS=1500

# Limite de requisições por IP por minuto
RATE_LIMIT_PER_MIN=20

# Origens permitidas (CORS) — separadas por vírgula
# Para deploy: adicione a URL pública do seu site
# Exemplo: ALLOWED_ORIGINS=http://localhost,https://seuprojeto.github.io
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,null
